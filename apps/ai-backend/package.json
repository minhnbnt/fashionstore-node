{
  "name": "ai-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vpx --watch src/server.ts",
    "build": "orval && tsc && vp pack",
    "codegen": "orval",
    "test": "vp test run",
    "start": "node dist/server.mjs",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.80",
    "ai": "7.0.156",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "orval": "8.44.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
