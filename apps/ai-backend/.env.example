GOTRUE_URL=http://localhost:9999
PORT=3000
GOTRUE_JWT_AUD=authenticated

# LLM OpenAI-compatible (đi qua gateway/caddy nếu cần)
AI_BASE_URL=https://api.kilo.ai/api/gateway/v1
AI_API_KEY=
AI_MODEL=

# Store API (Java) — mutator gọi tới đây, kèm Authorization của người dùng
STORE_API_URL=http://localhost:8080

# Origin cho phép của frontend; để trống ở dev thì mặc định `*`
CORS_ORIGIN=*

# S3/MinIO lưu ảnh kết quả thử đồ — cùng bộ env với embed-worker
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=fashionstore
S3_ACCESS_KEY=fashionstore
S3_SECRET_KEY=passwordpassword
S3_REGION=us-east-1

# Domain public của bucket, dùng ghép URL ảnh trả về cho tool showImage
ASSETS_URL=http://localhost:9000/fashionstore

# Server thử đồ ảo local (vton-ai Gradio API)
VTON_API_URL=http://localhost:8001
