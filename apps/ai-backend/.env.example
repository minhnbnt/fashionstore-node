GOTRUE_URL=http://localhost:9999
PORT=3000
GOTRUE_JWT_AUD=authenticated

# LLM OpenAI-compatible (đi qua gateway/caddy nếu cần)
AI_BASE_URL=https://api.kilo.ai/api/gateway/v1
AI_API_KEY=
AI_MODEL=

# Store API (Java) — mutator gọi tới đây, kèm Authorization của người dùng
STORE_API_URL=http://localhost:8080

# Origin cho phép của frontend; để trống ở dev thì mặc định `*`
CORS_ORIGIN=*
